PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = dev.mad.synthetic.typography.ios
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.0.1
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
GENERATE_INFOPLIST_FILE = YES
// Compose requires this host opt-in at runtime; supplement the generated keys.
INFOPLIST_FILE = Info.plist
INFOPLIST_KEY_CFBundleDisplayName = MadUIKit Synthetic S1
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../framework"
OTHER_LDFLAGS = $(inherited) -framework MadUIKitS1Adopter
